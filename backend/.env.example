# =============================================================================
# MediKiosk Backend Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: development | production | test
ENVIRONMENT=development

# Render automatically sets PORT. Locally defaults to 8000.
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# In Production (e.g. Render), supply DATABASE_URL directly.
# postgres:// and postgresql:// URLs are automatically normalized to postgresql+psycopg://.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/medikiosk_db

# Local development discrete credentials (used if DATABASE_URL is not set):
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medikiosk_db

# Production Connection Pooling Configuration:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (REQUIRED IN PRODUCTION)
# -----------------------------------------------------------------------------
# REQUIRED: Must be set to a cryptographically random string (min 32 characters) in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(64))"
# Insecure defaults will prevent startup when ENVIRONMENT=production.
JWT_SECRET=change-me-use-a-secure-random-value-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting for Authentication:
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, wildcards ('*') are strictly prohibited if credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# 5. DOCUMENT STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Provider options: local (default/dev/tests) | cloudinary (production)
DOCUMENT_STORAGE_PROVIDER=local
MAX_DOCUMENT_SIZE_MB=10
LOCAL_STORAGE_PATH=uploads

# Cloudinary Storage Configuration (Required ONLY if DOCUMENT_STORAGE_PROVIDER=cloudinary):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=medikiosk_documents
# CLOUDINARY_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 6. OCR, NLP & AI PROVIDERS (MOCK BY DEFAULT)
# -----------------------------------------------------------------------------
# Provider options: mock (safe default for all tests/dev) | gemini | sarvam
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
NLP_EXTRACTION_PROVIDER=mock
SUMMARY_PROVIDER=mock
TRANSLATION_PROVIDER=mock
ASR_PROVIDER=mock

# Google Gemini API (Required ONLY if any provider above is set to 'gemini'):
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=15

# Sarvam AI API (Required ONLY if ASR_PROVIDER or OCR_PROVIDER is set to 'sarvam'):
# SARVAM_API_KEY=your_sarvam_api_key_here
# SARVAM_MODEL=saaras:v3
# SARVAM_TIMEOUT_SECONDS=15

# Controlled LLM Fallback: Gemini -> Groq (Disabled by default):
LLM_FALLBACK_ENABLED=false
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 7. EXTERNAL INTEGRATIONS (MOCK BY DEFAULT)
# -----------------------------------------------------------------------------
# ABDM / ABHA Integration:
ABDM_ENABLED=true
ABDM_ENVIRONMENT=MOCK
# ABDM_BASE_URL=https://dev.abdm.gov.in
# ABDM_CLIENT_ID=your_abdm_client_id
# ABDM_CLIENT_SECRET=your_abdm_client_secret
# ABDM_TIMEOUT_SECONDS=10

# Hospital Information System (HIS) / EMR Integration:
HIS_ENABLED=true
HIS_ENVIRONMENT=MOCK
# HIS_BASE_URL=https://his.hospital.org/api
# HIS_CLIENT_ID=your_his_client_id
# HIS_CLIENT_SECRET=your_his_client_secret
# HIS_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 8. CLINICAL ENGINE & THRESHOLD SETTINGS
# -----------------------------------------------------------------------------
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60

ASR_SILENCE_THRESHOLD_MS=5000
SPEECH_QUALITY_FAILURE_WINDOW_MINUTES=15
SPEECH_QUALITY_REPEAT_THRESHOLD=2
SPEECH_QUALITY_TEXT_FALLBACK_THRESHOLD=3
SPEECH_QUALITY_ASSISTANCE_THRESHOLD=4

ADAPTIVE_OPEN_TO_GUIDED_THRESHOLD=2
ADAPTIVE_GUIDED_TO_TOUCH_THRESHOLD=2
ADAPTIVE_TOUCH_TO_ASSISTED_THRESHOLD=2

CONTRADICTION_HIGH_SEVERITY_CATEGORIES=ALLERGY,MEDICATION
CONTRADICTION_LOW_CONFIDENCE_SKIP=true
